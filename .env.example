# Copy this file to .env and fill in your values

# Model training
CONTAMINATION=0.01
RANDOM_STATE=42
N_ESTIMATORS=100
TEST_SIZE=0.2

# Log collector
NOTIFY_MIN_PRIORITY=MEDIUM
NOTIFY_COOLDOWN_SEC=60
NOTIFY_SOUND=true

# Email notifications (set NOTIFY_EMAIL_ENABLED=true to use)
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_FROM=your@gmail.com
NOTIFY_EMAIL_TO=admin@gmail.com
NOTIFY_EMAIL_HOST=smtp.gmail.com
NOTIFY_EMAIL_PORT=587
NOTIFY_EMAIL_USER=your@gmail.com
NOTIFY_EMAIL_PASS=your_app_password

# Agent authentication
AGENT_API_KEY=sentinel-secret-key

# Superadmin — always gets admin dashboard, stored nowhere in the DB
# Set these in Azure Portal → App Service → Configuration → Application settings
SUPERADMIN_USERNAME=your_admin_username
SUPERADMIN_PASSWORD=your_strong_password

# Docker / production
SECRET_KEY=sentinel-change-this-in-production
BACKEND_URL=http://localhost:8000

# Azure Cosmos DB — user accounts storage
# Get this from: Azure Portal → Cosmos DB account → Keys → PRIMARY CONNECTION STRING
COSMOS_CONNECTION_STRING=AccountEndpoint=https://your-account.documents.azure.com:443/;AccountKey=yourkey==;
